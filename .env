# API Configuration
VITE_API_URL=https://backend-ecomerce-shirt-6.onrender.com/api

# Application Settings
VITE_APP_NAME=Lumina Shirts
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_CART=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true

# Pagination
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Image Upload (if needed)
VITE_MAX_IMAGE_SIZE=5242880  # 5MB in bytes
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Currency
VITE_CURRENCY=USD
VITE_CURRENCY_SYMB=$

