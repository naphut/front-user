# API Configuration - ប្តូរទៅ URL របស់ Backend នៅលើ Render
VITE_API_URL=https://backend-ecomerce-shirt.onrender.com/api
REACT_APP_API_URL=https://backend-ecomerce-shirt.onrender.com/api

# Application Settings
VITE_APP_NAME=Lumina Shirts
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_CART=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true

# Currency
VITE_CURRENCY=USD
VITE_CURRENCY_SYMB=$